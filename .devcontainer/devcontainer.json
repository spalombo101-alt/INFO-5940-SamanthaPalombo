// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "INFO 5940",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

	// NOTE: OPENAI_API_KEY is deliberately NOT set here.
	//
	// Anything listed in remoteEnv overrides a GitHub Codespaces secret of the
	// same name, so hardcoding a key (or even an empty string) would silently
	// shadow the secret students are told to create. It would also mean pasting
	// a real key into a tracked file inside a public fork.
	//
	// Students set OPENAI_API_KEY as a Codespaces secret instead — see README.
	"remoteEnv": {
		"OPENAI_BASE_URL": "https://api.ai.it.cornell.edu/",
		"TZ": "America/New_York"
	},

	"postCreateCommand": "bash ./.devcontainer/setup.sh",

	// Streamlit's default port. Declared so the "Open in Browser" prompt is
	// reliable instead of a popup students have to catch in time.
	"forwardPorts": [8501],
	"portsAttributes": {
		"8501": {
			"label": "Streamlit App",
			"onAutoForward": "openBrowser"
		}
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-toolsai.jupyter"
			],
			"settings": {
				// Preselects the 3.11 interpreter so students don't have to
				// hunt for "Python 3.11.13 (first option)" in the kernel picker.
				"python.defaultInterpreterPath": "/usr/local/bin/python"
			}
		}
	}
}
