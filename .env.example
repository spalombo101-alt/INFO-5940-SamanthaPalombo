# Template for running OUTSIDE GitHub Codespaces (e.g. on your own laptop).
#
# In a Codespace you do NOT need this file — set OPENAI_API_KEY as a
# Codespaces secret instead, and the base URL is configured for you.
#
# To use locally:  cp .env.example .env   then fill in your key below.
# .env is gitignored. Never commit a real key.

OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://api.ai.it.cornell.edu/
